# CTIP server settings (mounted as /app/.env; the setup wizard edits it too)
SETUP_COMPLETED=true
# Required as soon as other machines can reach CTIP. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
API_TOKEN=
# Shared instance: login with user accounts (docs/deployment/user-accounts.md)
AUTH_MODE=accounts
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SECRET_KEY=
COMPUTE_BACKEND=cpu
CUDA_DEVICE=cpu
DATABASE_URL=sqlite:////data/db/trichome.db
DATA_ROOT=/data
IMAGES_DIR=/data/images
VIDEOS_DIR=/data/videos
MODELS_DIR=/data/models
OUTPUTS_DIR=/data/outputs
UPLOADS_DIR=/data/uploads
MLFLOW_TRACKING_URI=http://mlflow:5000
LABEL_STUDIO_URL=http://label-studio:8080
LABEL_STUDIO_API_KEY=
